# Copy to .env.https; use only via --env-file .env.https -f compose.https.yaml.
# Hex secrets avoid URL-escaping issues. Generate independently: openssl rand -hex 32
PHONE_DB_PASSWORD=
PHONE_JWT_SECRET=
# Default stays loopback; set the laptop's private LAN IPv4 to test a phone.
PHONE_BIND_IP=127.0.0.1
PHONE_HTTPS_PORT=8443
# Absolute path containing certificate.pem and key.pem (no root CA private key).
HTTPS_CERT_DIR=/home/nekit/NaryadAI/.local-certs/phone
